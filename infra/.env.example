# Copy to .env (kept out of git) before running:
#   cp infra/.env.example .env
#   docker compose -f infra/compose.tobe-stages.yaml up -d

# PostgreSQL image. PG 17 chosen over 18 because the official 18-alpine
# image changed its data-mount layout (PGDATA moved out of
# /var/lib/postgresql/data), which is incompatible with the standard
# named-volume pattern used here. Revisit when 18's docker conventions
# settle.
POSTGRES_IMAGE=postgres:17-alpine

# Shared credentials for all four stage DBs. Change before sharing the
# port over LAN / Tailscale.
TOBE_USER=tobe
TOBE_PASSWORD=tobe

# Host ports for each stage.
# Defaults (5440-5443) avoid the meta DB (5432) and a host PG you may
# already be running on 5433. Override here if any are taken.
DEV_PORT=5440
TEST_PORT=5441
STAGING_PORT=5442
PROD_PORT=5443
