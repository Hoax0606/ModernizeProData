# ── Claude Code 메타 ────────────────────────────────────────────────
# 팀 공통 설정·명령어·에이전트 (.claude/commands, .claude/agents,
# .claude/settings.json) 는 git 으로 공유.
# 개인 permission·세션 캐시·trace 만 제외.
.claude/settings.local.json
.claude/projects/
.claude/trace/

# ── 매뉴얼·문서 산출물 / 빌드 도구 ──────────────────────────────────
# .docx / .pdf / .pptx 같은 빌드 산출물 + 빌드 스크립트·CSS 는
# 외부 공개 의도가 아니므로 제외.
# .md 원본 (ARCHITECTURE / DESIGN / DEVELOPER_MANUAL / handoff/ 등) 만 공유.
docs/*.docx
docs/*.pdf
docs/*.pptx
docs/build-*.ps1
docs/make-*.py
docs/*.css

# ── 사용자 메모리 디렉토리 (도구 메타) ───────────────────────────────
**/memory/

# ── OS 메타 ─────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Office 임시 / 락 파일 ───────────────────────────────────────────
~$*
*.tmp
*.bak
*~

# ── Node / 빌드 산출물 ──────────────────────────────────────────────
node_modules/
dist/
build/
.cache/
.parcel-cache/
.next/

# ── Maven / Java 빌드 산출물 ────────────────────────────────────────
target/
*.class
*.jar
*.war
*.ear
.mvn/wrapper/maven-wrapper.jar
.factorypath
HELP.md

# ── Spring Boot ─────────────────────────────────────────────────────
spring-shell.log
application-local.properties
application-local.yml

# ── 런타임 데이터 (메타 DB·DuckDB 파일 등) ──────────────────────────
ModernizeProData/backend/data/
ModernizeProData/**/data/
*.db
*.db.lock
*.db.mv.db
*.trace.db

# ── Editor / IDE ────────────────────────────────────────────────────
.vscode/
.idea/
*.iml
*.swp
*.swo
.history/

# ── 환경설정·자격증명 ──────────────────────────────────────────────
.env
.env.*
!infra/.env.example
*.local
*.pem
*.key
*.p12
*.jks
*.crt
*.p8
secrets/
credentials/

# license public key 는 빌드 시 jar 에 임베드되어야 하므로 예외로 track.
# private.pem 은 그대로 ignore (이름이 다르므로 위 *.pem 규칙에 걸림).
!ModernizeProData/backend/src/main/resources/license/public.pem
# update public key 도 동일 패턴 — jar 에 임베드되어 도구가 서명 검증.
!ModernizeProData/backend/src/main/resources/license/mpd-update-public.pem

# ── 로그 ────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Vite / Frontend 캐시·임시 ───────────────────────────────────────
.vite/
vite.config.ts.timestamp-*
vite.config.js.timestamp-*

# ── Java / JVM 크래시·힙덤프 ────────────────────────────────────────
hs_err_pid*.log
replay_pid*.log
*.hprof

# ── Python 산출물 (docs/make-*.py 같은 빌드 스크립트용) ─────────────
__pycache__/
*.pyc

# ── Git / Merge 잔재 ────────────────────────────────────────────────
*.orig
*.rej

# ── jpackage installer 빌드 산출물 ─────────────────────────────────
ModernizeProData/installer/staging/
ModernizeProData/installer/dist/
ModernizeProData/installer/cache/
ModernizeProData/installer/assets/mpd.ico
# Vite prod build → backend resources/static/ 으로 stage 됨 (빌드 산출물).
ModernizeProData/backend/src/main/resources/static/

# ── .NET WebView2 host 빌드 산출물 ─────────────────────────────────
# webview-host/dist/ 는 release artifact (build.ps1 가 staging 으로 복사),
# bin/ + obj/ 는 매 빌드마다 새로 생성되는 중간 파일. 둘 다 ignore.
ModernizeProData/installer/webview-host/bin/
ModernizeProData/installer/webview-host/obj/
ModernizeProData/installer/webview-host/dist/

# ── Docker 로컬 override ────────────────────────────────────────────
compose.override.yaml
compose.override.yml
docker-compose.override.yaml
docker-compose.override.yml

# ── Local-only DDL + sample CSV ────────────────────────────────────
# AS-IS / TO-BE schema (db/asis, db/tobe) 와 sample CSV 는 git 에 올리지
# 않는다. 용량 (수백 MB ~ 1.5 GB) + 재생성 가능 + 팀원 PC 는 .msi 설치본의
# 외부 PG (5433 메타 DB) 만 쓰므로 굳이 공유할 필요가 없음.
# Coordinator (docker tobe-stages 띄우는 사람) 만 local 에 보관.
# 선행 슬래시 — repo 루트의 db/ 만. backend 의 db/migration 까지 무시되지 않게.
/db/
